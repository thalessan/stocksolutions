# Uso: PRD_SSH_PASS=... expect scripts/prd-run-php.expect <arquivo.php> <MARCADOR-FINAL> [args...]
#
# Envia um arquivo PHP para o PRD, executa com wp-cli (eval-file) e remove o
# arquivo remoto. O marcador final deve ser ecoado pelo próprio PHP.
# Argumentos extras são repassados ao PHP e chegam em $args.
#
# Variáveis de ambiente:
#   PRD_SSH_PASS  (obrigatória) senha SSH
#   PRD_SSH_HOST  (opcional)    default: ssh.uhserver.com
#   PRD_SSH_USER  (opcional)    default: stocksolut2
#   PRD_WP_PATH   (opcional)    default: stocksolutions.com.br/web
#
# O gateway SSH da UOL derruba conexões em sequência (fail2ban): o script
# tenta até 4 vezes com espera de 55s entre tentativas.

set timeout 300
set phpfile [lindex $argv 0]
set marker  [lindex $argv 1]
set extra   [lrange $argv 2 end]
if {$phpfile eq "" || $marker eq ""} {
  puts "uso: PRD_SSH_PASS=... expect prd-run-php.expect <arquivo.php> <MARCADOR> \[args...\]"
  exit 2
}
if {![info exists env(PRD_SSH_PASS)]} {
  puts "defina PRD_SSH_PASS no ambiente"
  exit 2
}

set host   [expr {[info exists env(PRD_SSH_HOST)] ? $env(PRD_SSH_HOST) : "ssh.uhserver.com"}]
set user   [expr {[info exists env(PRD_SSH_USER)] ? $env(PRD_SSH_USER) : "stocksolut2"}]
set pass   $env(PRD_SSH_PASS)
set wppath [expr {[info exists env(PRD_WP_PATH)] ? $env(PRD_WP_PATH) : "stocksolutions.com.br/web"}]

set tries 0
set done 0

while {$tries < 4} {
  incr tries
  if {$tries > 1} { sleep 55 }
  puts "\n### tentativa $tries ###"
  if {[catch {
    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -l $user $host
    expect {
      -timeout 60
      "password:" { send "$pass\r" }
      eof { error "closed pre-auth" }
      timeout { error "timeout pre-auth" }
    }
    expect {
      -timeout 60
      -re {\]\$ } {}
      "Connection closed" { error "closed post-auth" }
      "Permission denied" { error "denied" }
      eof { error "closed" }
      timeout { error "no shell" }
    }
  } err]} {
    puts "falha login ($err)"
    catch { expect eof }
  } else {
    set b64 [string trim [exec base64 -i $phpfile]]
    regsub -all {\n} $b64 {} b64
    set argstr [join $extra " "]

    # PRD_RUN=php executa o arquivo direto com o PHP do servidor (sem WordPress),
    # necessario para scripts que editam o proprio wp-config.php.
    if {[info exists env(PRD_RUN)] && $env(PRD_RUN) eq "php"} {
      set cmd "cd ~ && echo $b64 | php -r 'file_put_contents(\"prd-tmp.php\", base64_decode(stream_get_contents(STDIN)));' && php prd-tmp.php $argstr; rm -f prd-tmp.php"
    } else {
      set cmd "cd ~ && echo $b64 | php -r 'file_put_contents(\"prd-tmp.php\", base64_decode(stream_get_contents(STDIN)));' && php wp-cli.phar eval-file prd-tmp.php $argstr --path=$wppath; rm -f prd-tmp.php"
    }

    send "$cmd\r"
    if {[catch {
      expect {
        -timeout 180
        -re $marker {}
        timeout { error "timeout $marker" }
        eof { error "closed $marker" }
      }
    } e2]} {
      puts "falha ($e2)"
      catch { expect eof }
    } else {
      send "exit\r"
      catch { expect eof }
      puts "CONCLUIDO"
      set done 1
      break
    }
  }
}
if {$done} { puts "RESULTADO: OK" } else { puts "RESULTADO: FALHOU" }
